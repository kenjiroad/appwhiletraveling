{
  "expo": {
    "name": "Debout",
    "slug": "debout",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "debout",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "fr.debout.app",
      "supportsTablet": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Debout utilise la caméra pour compter tes pompes et tes squats. Tout est analysé sur ton téléphone : aucune image n’est envoyée ni enregistrée.",
        "NSAlarmKitUsageDescription": "Debout sonne comme un vrai réveil, même en mode silencieux, jusqu’à ce que tu aies fait tes pompes.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-notifications",
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "owner": "kenjiroad",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/e3e7b9e6-2d83-40c0-80b4-55348f25b4f4"
    },
    "extra": {
      "eas": {
        "projectId": "e3e7b9e6-2d83-40c0-80b4-55348f25b4f4"
      }
    }
  }
}
