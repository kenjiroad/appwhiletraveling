# Copie ce fichier en « .env » (même dossier) et remplis avec les valeurs de ton projet Supabase :
# supabase.com → ton projet → Project Settings → API.
# Sans ces deux lignes, l'app reste en mode démo (tout en local, ligue fictive).
EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Abonnements (RevenueCat) : app.revenuecat.com → ton projet → API keys → clé publique iOS (commence par « appl_ »).
# Sans cette ligne, les achats restent factices (mode démo).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
